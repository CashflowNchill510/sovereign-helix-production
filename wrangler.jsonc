{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sovereign-helix",
  "main": "worker.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  }
}
